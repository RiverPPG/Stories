# Local development (docker compose up)
DATABASE_URL=postgresql://stories:stories_dev@localhost:5432/short_stories
JWT_SECRET=change-me-to-a-random-secret
PORT=3000

# Cloudflare R2 (required for avatar uploads)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Coolify fills POSTGRES credentials, JWT_SECRET, and DATABASE_URL from
# docker-compose.prod.yml. Set the R2_* values in the Coolify UI.
